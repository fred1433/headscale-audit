// Lab policy: three roles, one deliberate boundary. The web tier reaches the
// database tier on 8081, the CI node does not. lab/verify.sh proves both
// directions against the running clients.
{
  "tagOwners": {
    "tag:web": ["lab@"],
    "tag:db": ["lab@"],
    "tag:ci": ["lab@"],
  },
  "grants": [
    {
      "src": ["tag:web"],
      "dst": ["tag:db"],
      "ip": ["8081"],
    },
  ],
  // Headscale evaluates this block on every reload and refuses the policy when
  // it does not hold. A tag only resolves once a node carries it, so the
  // bootstrap policy has no tests and lab/verify.sh loads this one after the
  // three nodes are enrolled.
  "tests": [
    {
      "src": "tag:web",
      "accept": ["tag:db:8081"],
      "deny": ["tag:ci:8081"],
    },
  ],
}
